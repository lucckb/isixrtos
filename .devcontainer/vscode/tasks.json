{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "meson: compile tests",
			"type": "shell",
			"command": "meson compile -C build",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "qemu: gdb server",
			"type": "shell",
			"dependsOn": "meson: compile tests",
			"command": ".devcontainer/scripts/qemu-gdb-server.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "qemu",
				"pattern": {
					"regexp": "^(.*)$",
					"file": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "QEMU GDB server listening",
					"endsPattern": "QEMU GDB server listening"
				}
			}
		}
	]
}
