# Linux native build of arm-none-eabi toolchain (same family as mac/win scripts).

_toolchain_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../versions.env
source "${_toolchain_dir}/versions.env"

TARGET=arm-none-eabi
BASENAME=arm-none-eabi-gcc

PREFIX="${PREFIX:-/opt/arm-none-eabi-gcc}"
CHOST="${CHOST:-$(gcc -dumpmachine)}"
BUILD_JOBS="${BUILD_JOBS:-$(nproc)}"

declare -A dl_urls=(
	[binutils]="${BINUTILS_URL}"
	[gcc]="${GCC_URL}"
	[newlib]="${NEWLIB_URL}"
	[gdb]="${GDB_URL}"
)

declare -A pkg_dirs=(
	[binutils]="binutils-${BINUTILS_VER}"
	[gcc]="gcc-${GCC_VER}"
	[newlib]="newlib-${NEWLIB_VER}"
	[gdb]="gdb-${GDB_VER}"
)

BASEDIR="${BASEDIR:-$(pwd)/tmp}"
DLDIR="${BASEDIR}/dl"
