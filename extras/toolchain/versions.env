# Shared arm-none-eabi toolchain component versions.
# Sourced by linux/, mac/, and win/ build helpers — keep this file as the
# single source of truth for BINUTILS/GCC/NEWLIB/GDB.
#
# Host paths, Mingw/expat, and configure flags stay in the per-OS scripts.

BINUTILS_VER=2.45
GCC_VER=16.1.0
NEWLIB_VER=4.5.0.20241231
GDB_VER=16.2

BINUTILS_URL="https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VER}.tar.xz"
GCC_URL="https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VER}/gcc-${GCC_VER}.tar.xz"
NEWLIB_URL="https://sourceware.org/pub/newlib/newlib-${NEWLIB_VER}.tar.gz"
GDB_URL="https://ftp.gnu.org/gnu/gdb/gdb-${GDB_VER}.tar.xz"
