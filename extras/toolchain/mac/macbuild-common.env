_toolchain_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../versions.env
source "${_toolchain_dir}/versions.env"

#For which target
TARGET=arm-none-eabi

#Basename for binary
BASENAME="arm-none-eabi-gcc"

#Parallel build
export MAKEFLAGS="-j8"

#Downloads URL (versions from extras/toolchain/versions.env)
declare -A dl_urls
dl_urls=(
		  [binutils]="$BINUTILS_URL" \
		  [gccbase]="$GCC_URL" \
		  [gcc]="$GCC_URL" \
		  [newlib]="$NEWLIB_URL" \
		  [gdb]="$GDB_URL" \
		)


#CHOST=x86_64-apple-darwin20
		

#BASE build path
BASEDIR=$(pwd)/tmp
DLDIR="$BASEDIR/dl"
PREFIX="/usr/local/arm-none-eabi-gcc"
BPREFIX="$BASEDIR/tbuild"
export PATH=$PATH:$DESTDIR/usr/local/bin:$BPREFIX


declare -A dl_names
declare -A pkg_dirs
for index in ${!dl_urls[*]}
do
	name="$(basename ${dl_urls[$index]})" 
	namene=${name%.*}
	namene=${namene%.*}
	dl_names+=( [$index]="$name" )
	pkg_dirs+=( [$index]="$namene" )
done


download() {
echo "Num files for download: ${#dl_urls[*]}"
for item in ${dl_urls[*]}
do
	local bn=$(basename $item)
	if [ ! -f "$DLDIR/$bn" ]; then
		printf " Downloading %s\n" $bn
		wget -P $DLDIR $item
	fi
done
}

unpackall() {
for index in ${!dl_names[*]}
do
	local item="${dl_names[$index]}" 
	local diri="${pkg_dirs[$index]}" 
	if [ ! -d "$BASEDIR/$diri" ]; then
		echo "Unpacking $item ..."
		tar xf "$DLDIR/$item" -C $BASEDIR
	fi
done
}

prepare_dirs() {
	mkdir -p $DLDIR
	mkdir -p $BPREFIX
	#cd $BPREFIX
	#for i in /usr/local/bin/x86_64-apple-darwin20-*; do
		#name=$(basename $i); ln -sf $i  ${name/-11/};
	#done
	#cd -
	#x86_64-apple-darwin20-gcc -v
}

